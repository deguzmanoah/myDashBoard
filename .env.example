# Third-party API Configuration
# Replace these with your actual API endpoints and credentials
THIRD_PARTY_API_ROOT_URL=https://your-api-domain.com
THIRD_PARTY_API_WEB_URL=https://your-api-domain.com/web

# Example values (replace with real ones):
# THIRD_PARTY_API_URL=https://api.evcharge.com/v1

# Development Authentication Bypass (Development Only)
# Set to 'true' to enable bypass login for development
# This should NEVER be enabled in production
ENABLE_DEV_LOGIN_BYPASS=false

# Google Maps API Configuration
# You need to obtain this API key from Google Cloud Console
# Make sure to enable the following APIs:
# - Maps JavaScript API
# - Places API
# - Geocoding API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
